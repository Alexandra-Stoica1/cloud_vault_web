# Copy this file to .env.local and adjust the values.

# FastAPI backend (cloud_vault). Called only from the Next.js server, never from the browser.
API_URL=http://127.0.0.1:8000

# Lifetime of the refresh token cookie, in seconds. Keep it equal to REFRESH_TOKEN_EXPIRE_DAYS
# in the API (7 days by default).
REFRESH_TOKEN_MAX_AGE=604800

# Send the session cookies over HTTPS only. Defaults to true when NODE_ENV=production.
# Set it to false only when the production build is served over plain HTTP (e.g. a local IIS test).
# COOKIE_SECURE=true
